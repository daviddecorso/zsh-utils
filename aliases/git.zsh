alias gs="git status"
alias gb="git branch"
alias gf="git fetch"
alias gp="git fetch && git pull"
alias gpm="git fetch && git pull origin main"
alias gpull="git pull origin "
alias gupull="git pull upstream "
alias gpush="git push origin "
alias gc="git checkout "
alias gcm="git checkout main"
alias gcom="git commit -m "
alias gru="git fetch upstream main && git rebase -i upstream/main"
alias gfu="git fetch upstream main"
alias fix="git commit --fixup HEAD"
alias unstage="git restore --staged"
alias gpr="gh pr create --web"
alias prs="gh pr list"
alias prc="gh pr checkout"
alias lgtm="gh pr review --approve"
