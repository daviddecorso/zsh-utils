# Prints gwt's include patterns for the main checkout at $1: its .gwtinclude, else $GWT_INCLUDE, else the defaults.
emulate -L zsh
setopt extended_glob

local file="$1/.gwtinclude"
if [[ -f $file ]]; then
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    line="${${line##[[:space:]]#}%%[[:space:]]#}"
    [[ -z $line || $line == \#* ]] || print -r -- "$line"
  done < "$file"
elif (( ${+GWT_INCLUDE} )); then
  print -rl -- $GWT_INCLUDE
else
  print -rl -- '.env*' google-services.json 'ios/*/GoogleService-Info.plist' .xcode.env.local node_modules/ ios/Pods/
fi
