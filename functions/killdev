local servers=(
  "vite"
  "wrangler"
  "expo"
  "next"
  "nuxt"
  "webpack"
  "react-scripts"
  "nodemon"
  "turbo"
)

echo "Terminating dev servers..."

# Match only an executable path segment (".../.bin/next dev"), not the word anywhere in a command line.
local server
for server in "${servers[@]}"; do
  pkill -f "(^|/)${server}(\.[cm]?js)?( |$)" 2>/dev/null
done

echo "✅ All clean!"
