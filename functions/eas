# eas wrapper — nags about version bump before any build
if [[ "$1" == "build" ]]; then
  local app_json
  app_json=$(git rev-parse --show-toplevel 2>/dev/null)/app.json

  if [[ -f "$app_json" ]]; then
    local version build_num
    version=$(node -e "try{const a=require('$app_json');process.stdout.write(a.expo.version||'?')}catch(e){process.stdout.write('?')}")
    build_num=$(node -e "try{const a=require('$app_json');process.stdout.write(String(a.expo.ios?.buildNumber||a.expo.android?.versionCode||'?'))}catch(e){process.stdout.write('?')}")

    # Check if app.json has any uncommitted changes (staged or unstaged)
    if git -C "$(dirname "$app_json")" diff --name-only HEAD -- app.json 2>/dev/null | grep -q "app.json" || \
       git -C "$(dirname "$app_json")" diff --cached --name-only -- app.json 2>/dev/null | grep -q "app.json"; then
      echo "✅ app.json modified — version: $version  build: $build_num"
    else
      echo ""
      echo "⚠️  app.json unchanged since last commit"
      echo "   version:  $version"
      echo "   build:    $build_num"
      echo ""
      echo -n "   Bump the version first? [y to abort, Enter to continue anyway] "
      local confirm
      read -r confirm
      if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        echo "   Aborting. Bump app.json and re-run."
        return 1
      fi
      echo "   Proceeding without bump..."
      echo ""
    fi
  fi
fi

command eas "$@"
